[
  {"id": "l01", "text": "One sunny morning, Little Dog is walking in the forest. He sees his friend, Tabby Cat.", "voice": "af_heart", "speed": 0.88, "lang": "en-us"},
  {"id": "l02", "text": "Hello, Kitty! Good morning!", "voice": "af_sky", "speed": 0.90, "lang": "en-us"},
  {"id": "l03", "text": "Good morning, Doggy! Where are you going?", "voice": "bf_emma", "speed": 0.90, "lang": "en-gb"},
  {"id": "l04", "text": "I am going to the river. Do you want to come with me?", "voice": "af_sky", "speed": 0.89, "lang": "en-us"},
  {"id": "l05", "text": "Yes! Let's go together!", "voice": "bf_emma", "speed": 0.91, "lang": "en-gb"},
  {"id": "l06", "text": "Suddenly, they hear a loud sound.", "voice": "af_heart", "speed": 0.86, "lang": "en-us"},
  {"id": "l07", "text": "Oh! What is that sound?", "voice": "af_sky", "speed": 0.88, "lang": "en-us"},
  {"id": "l08", "text": "I don't know. I am scared!", "voice": "bf_emma", "speed": 0.88, "lang": "en-gb"},
  {"id": "l09", "text": "Then, a big gray wolf comes out from behind a tree.", "voice": "af_heart", "speed": 0.86, "lang": "en-us"},
  {"id": "l10", "text": "Hello, little friends!", "voice": "am_michael", "speed": 0.84, "lang": "en-us"},
  {"id": "l11", "text": "Oh no! A wolf!", "voice": "af_bella", "speed": 0.85, "lang": "en-us"},
  {"id": "l12", "text": "Please do not eat us!", "voice": "bf_emma", "speed": 0.86, "lang": "en-gb"},
  {"id": "l13", "text": "Ha ha ha! Don't be afraid. I am not going to hurt you.", "voice": "am_michael", "speed": 0.85, "lang": "en-us"},
  {"id": "l14", "text": "The wolf looks sad.", "voice": "af_heart", "speed": 0.84, "lang": "en-us"},
  {"id": "l15", "text": "Why are you sad, Mr. Wolf?", "voice": "af_sky", "speed": 0.88, "lang": "en-us"},
  {"id": "l16", "text": "I am hungry. I can't find any food.", "voice": "am_michael", "speed": 0.83, "lang": "en-us"},
  {"id": "l17", "text": "Oh! We have some apples. Would you like one?", "voice": "bf_emma", "speed": 0.89, "lang": "en-gb"},
  {"id": "l18", "text": "Really? Thank you so much!", "voice": "am_michael", "speed": 0.86, "lang": "en-us"},
  {"id": "l19", "text": "Here you are!", "voice": "af_sky", "speed": 0.90, "lang": "en-us"},
  {"id": "l20", "text": "Yummy! This apple is delicious!", "voice": "am_michael", "speed": 0.86, "lang": "en-us"},
  {"id": "l21", "text": "The three friends sit under a big tree and eat apples together.", "voice": "af_heart", "speed": 0.86, "lang": "en-us"},
  {"id": "l22", "text": "Mr. Wolf, do you want to be our friend?", "voice": "bf_emma", "speed": 0.89, "lang": "en-gb"},
  {"id": "l23", "text": "Of course! I would love to!", "voice": "am_michael", "speed": 0.86, "lang": "en-us"},
  {"id": "l24", "text": "Yay! We have a new friend!", "voice": "af_sky", "speed": 0.91, "lang": "en-us"},
  {"id": "l25", "text": "Thank you, little friends. You are very kind!", "voice": "am_michael", "speed": 0.85, "lang": "en-us"},
  {"id": "l26", "text": "Friends help each other!", "voice": "bf_emma", "speed": 0.88, "lang": "en-gb"},
  {"id": "l27", "text": "The end!", "voice": "af_bella", "speed": 0.84, "lang": "en-us"}
]
