[
  {"id": "l01", "text": "Here is a little seed.", "vi": "Đây là một hạt giống nhỏ.", "key": "seed", "voice": "af_heart", "speed": 0.85},
  {"id": "l02", "text": "It is fast asleep.", "vi": "Nó đang ngủ say giấc.", "voice": "af_heart", "speed": 0.84},
  {"id": "l03", "text": "Leo wants a flower.", "vi": "Leo muốn có một bông hoa.", "key": "flower", "voice": "af_heart", "speed": 0.86},
  {"id": "l04", "text": "Wake up, seed! Here comes the sun.", "vi": "Dậy đi hạt nhỏ! Mặt trời tới rồi.", "key": "sun", "voice": "af_heart", "speed": 0.86},
  {"id": "l05", "text": "Oh no! Too hot!", "vi": "Ôi không! Nóng quá!", "voice": "af_heart", "speed": 0.85},
  {"id": "l06", "text": "Leo draws a big blue cloud.", "vi": "Leo vẽ một đám mây xanh thật to.", "key": "cloud", "voice": "af_heart", "speed": 0.86},
  {"id": "l07", "text": "Down comes the cool rain!", "vi": "Cơn mưa mát lành rơi xuống!", "key": "rain", "voice": "af_heart", "speed": 0.86},
  {"id": "l08", "text": "Look! Hidden roots drink the water.", "vi": "Nhìn kìa! Rễ cây ẩn mình đang uống nước.", "key": "roots", "voice": "af_heart", "speed": 0.85},
  {"id": "l09", "text": "Hooray! A tall red flower!", "vi": "Hoan hô! Một bông hoa đỏ thật cao!", "key": "flower", "voice": "af_heart", "speed": 0.86},
  {"id": "l10", "text": "Well done, little seed.", "vi": "Giỏi lắm, hạt giống nhỏ ơi.", "key": "seed", "voice": "af_heart", "speed": 0.82}
]
